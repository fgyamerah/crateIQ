# CrateIQ local runtime configuration (non-secret template)
#
# Copy to a local env file or export the variables in your shell. Never put
# real secrets in this template or commit them anywhere in the repository.
#
# SECURITY NOTE: CrateIQ has NO authentication. Run the backend and frontend
# only on a trusted local machine and never expose them to a network you do
# not fully control.
#
# Use a repository-controlled or temporary fixture root for development and
# tests. Do not point write-capable commands at a real music library by
# default.

# ---------------------------------------------------------------------------
# Library root
# ---------------------------------------------------------------------------

# Preferred CrateIQ backend library root. Must be absolute when set.
CRATEIQ_LIBRARY_ROOT=/absolute/path/to/library

# Deprecated compatibility alias. It is read only when CRATEIQ_LIBRARY_ROOT
# is unset; migrate local setups when convenient.
# CRATEMINDAI_LIBRARY_ROOT=/absolute/path/to/library

# Pipeline compatibility variables retained from the upstream product.
# DJ_MUSIC_ROOT=/absolute/path/to/library

# The readiness preflight (GET /api/runtime/readiness) rejects broad roots
# such as /, /home, /Users, your home directory, or the repository itself.
# Set this to 1 only if you deliberately need such a root.
# CRATEIQ_ALLOW_UNSAFE_ROOT=1

# ---------------------------------------------------------------------------
# External binaries (optional overrides — defaults resolve from PATH)
# Missing binaries degrade readiness with a warning; they never break startup.
# ---------------------------------------------------------------------------
# FFPROBE_BIN=ffprobe
# FFMPEG_BIN=ffmpeg
# Leave these blank (or unset) to search PATH. Set an explicit executable
# path only when a tool was installed outside PATH; do not commit local paths.
KEYFINDER_BIN=
AUBIO_BIN=
BEET_BIN=
# Linux Mint examples (uncomment only when they match the local machine):
# AUBIO_BIN=/usr/bin/aubio
# BEET_BIN=/usr/bin/beet
# keyfinder-cli installation paths vary by package, release binary, or build.
# KEYFINDER_BIN=/path/to/keyfinder-cli
# RMLINT_BIN=rmlint
# RSYNC_BIN=rsync

# ---------------------------------------------------------------------------
# Rekordbox export path mapping (optional)
# ---------------------------------------------------------------------------
# RB_LINUX_ROOT=/absolute/path/to/ssd/mount
# RB_WIN_DRIVE=M
# DJ_WIN_DRIVE=E

# ---------------------------------------------------------------------------
# Local AI (optional; local-first, no cloud required)
# ---------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=120

# ---------------------------------------------------------------------------
# Online enrichment providers (optional — placeholders only, never secrets)
# ---------------------------------------------------------------------------
# SPOTIFY_CLIENT_ID=your-client-id-here
# SPOTIFY_CLIENT_SECRET=your-client-secret-here
# ENRICH_ONLINE_MIN_CONFIDENCE=0.90
